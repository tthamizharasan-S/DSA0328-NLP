import math
from collections import defaultdict, Counter

class SimplePOSTagger:
    def __init__(self):
        self.transition = defaultdict(Counter)
        self.emission = defaultdict(Counter)
        self.tag_counts = Counter()
        self.tags = set()
        self.vocab = set()

    def train(self, tagged_sentences):
        for sentence in tagged_sentences:
            prev_tag = "<START>"

            for word, tag in sentence:
                self.transition[prev_tag][tag] += 1
                self.emission[tag][word] += 1
                self.tag_counts[tag] += 1
                self.tags.add(tag)
                self.vocab.add(word)
                prev_tag = tag

            self.transition[prev_tag]["<END>"] += 1

        self.transition_prob = {}
        self.emission_prob = {}

        for prev_tag, counter in self.transition.items():
            total = sum(counter.values()) + len(self.tags)
            self.transition_prob[prev_tag] = {}
            for tag in self.tags:
                count = counter[tag] + 1
                self.transition_prob[prev_tag][tag] = math.log(count / total)

        for tag, counter in self.emission.items():
            total = sum(counter.values()) + len(self.vocab)
            self.emission_prob[tag] = {}
            for word in self.vocab:
                count = counter[word] + 1  
                self.emission_prob[tag][word] = math.log(count / total)

    def get_emission(self, tag, word):
    
        if word in self.vocab:
            return self.emission_prob[tag].get(word, math.log(1e-6))
        else:
            return math.log(1e-6)

    def viterbi(self, sentence):
        V = [{}]
        path = {}

        for tag in self.tags:
            trans_p = self.transition_prob.get("<START>", {}).get(tag, math.log(1e-6))
            emit_p = self.get_emission(tag, sentence[0])
            V[0][tag] = trans_p + emit_p
            path[tag] = [tag]

        for t in range(1, len(sentence)):
            V.append({})
            new_path = {}

            for curr_tag in self.tags:
                max_prob = float('-inf')
                best_prev = None

                for prev_tag in V[t - 1]:
                    trans_p = self.transition_prob.get(prev_tag, {}).get(curr_tag, math.log(1e-6))
                    emit_p = self.get_emission(curr_tag, sentence[t])

                    prob = V[t - 1][prev_tag] + trans_p + emit_p

                    if prob > max_prob:
                        max_prob = prob
                        best_prev = prev_tag

                if best_prev is not None:
                    V[t][curr_tag] = max_prob
                    new_path[curr_tag] = path[best_prev] + [curr_tag]

            path = new_path

        max_prob = float('-inf')
        best_tag = None

        for tag in V[-1]:
            prob = V[-1][tag] + self.transition_prob.get(tag, {}).get("<END>", math.log(1e-6))
            if prob > max_prob:
                max_prob = prob
                best_tag = tag

        return list(zip(sentence, path[best_tag]))


if __name__ == "__main__":

    train_data = [
        [("I", "PRON"), ("eat", "VERB"), ("rice", "NOUN")],
        [("You", "PRON"), ("eat", "VERB"), ("food", "NOUN")],
        [("They", "PRON"), ("cook", "VERB"), ("rice", "NOUN")],
        [("She", "PRON"), ("likes", "VERB"), ("food", "NOUN")]
    ]

    tagger = SimplePOSTagger()
    tagger.train(train_data)

    test_sentence = ["I", "cook", "food"]

    tagged_output = tagger.viterbi(test_sentence)

    print("Input Sentence:", test_sentence)
    print("Tagged Output:")
    for word, tag in tagged_output:
        print(f"{word} -> {tag}")
